{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-atlas:contract:2026.08.3:tool:atlas.text.search.v1:output",
  "title": "atlas.text.search.v1 — result",
  "description": "Rank entities and assertions by a deterministic text scorer. The answer states what was searchable: encrypted content is not scanned, and the count of what could not be searched is reported rather than silently excluded.",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number",
            "minimum": 0
          },
          "match_basis": {
            "type": "string",
            "enum": [
              "display-name",
              "also-known-as",
              "assertion-value",
              "evidence",
              "other"
            ]
          },
          "record": {
            "type": "object",
            "required": [
              "record_schema"
            ],
            "properties": {
              "record_schema": {
                "type": "string",
                "minLength": 1,
                "x-atlas-known-values": [
                  "atlas.entity:v1",
                  "atlas.assertion:v1",
                  "atlas.redaction:v1"
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "required": [
                    "record_schema"
                  ],
                  "properties": {
                    "record_schema": {
                      "const": "atlas.entity:v1"
                    }
                  }
                },
                "then": {
                  "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.entity:v1"
                }
              },
              {
                "if": {
                  "required": [
                    "record_schema"
                  ],
                  "properties": {
                    "record_schema": {
                      "const": "atlas.assertion:v1"
                    }
                  }
                },
                "then": {
                  "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.assertion:v1"
                }
              },
              {
                "if": {
                  "required": [
                    "record_schema"
                  ],
                  "properties": {
                    "record_schema": {
                      "const": "atlas.redaction:v1"
                    }
                  }
                },
                "then": {
                  "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.redaction:v1"
                }
              }
            ]
          }
        },
        "required": [
          "score",
          "match_basis",
          "record"
        ]
      }
    },
    "search_scope": {
      "type": "object",
      "properties": {
        "scorer": {
          "type": "string",
          "enum": [
            "deterministic-text",
            "embedding",
            "other"
          ]
        },
        "plaintext_candidates": {
          "type": "integer",
          "minimum": 0
        },
        "encrypted_unsearchable": {
          "type": "integer",
          "minimum": 0,
          "description": "Records that could not be scanned because their content is encrypted at rest. The prior remote path filtered to plaintext with score>0 and reported nothing, so an encrypted match was indistinguishable from no match."
        },
        "counts_basis": {
          "type": "string",
          "enum": [
            "exact",
            "bucketed",
            "other"
          ]
        }
      },
      "required": [
        "scorer",
        "plaintext_candidates",
        "encrypted_unsearchable",
        "counts_basis"
      ]
    },
    "page": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/page"
    },
    "coverage": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/coverage"
    },
    "horizon": {
      "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.horizon:v1"
    },
    "cache": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/cache"
    }
  },
  "required": [
    "results",
    "search_scope",
    "page",
    "coverage",
    "horizon",
    "cache"
  ]
}
