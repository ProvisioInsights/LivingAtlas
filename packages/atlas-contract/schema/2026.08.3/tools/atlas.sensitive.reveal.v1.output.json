{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-atlas:contract:2026.08.3:tool:atlas.sensitive.reveal.v1:output",
  "title": "atlas.sensitive.reveal.v1 — result",
  "description": "Ask for the record behind an atlas.redaction:v1 stub. This is not a read: it always produces a durable audit event, and it may return input_required so the owner can decide in their own client. Requires the elicitation capability; without it the refusal names the capability rather than issuing a request nobody can answer.",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "revealed",
        "input-required",
        "refused",
        "other"
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "record_schema"
      ],
      "properties": {
        "record_schema": {
          "type": "string",
          "minLength": 1,
          "x-atlas-known-values": [
            "atlas.assertion:v1",
            "atlas.entity:v1",
            "atlas.redaction:v1"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "record_schema"
            ],
            "properties": {
              "record_schema": {
                "const": "atlas.assertion:v1"
              }
            }
          },
          "then": {
            "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.assertion:v1"
          }
        },
        {
          "if": {
            "required": [
              "record_schema"
            ],
            "properties": {
              "record_schema": {
                "const": "atlas.entity:v1"
              }
            }
          },
          "then": {
            "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.entity:v1"
          }
        },
        {
          "if": {
            "required": [
              "record_schema"
            ],
            "properties": {
              "record_schema": {
                "const": "atlas.redaction:v1"
              }
            }
          },
          "then": {
            "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.redaction:v1"
          }
        }
      ]
    },
    "input_request": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/reveal_input_request"
    },
    "audit": {
      "type": "object",
      "description": "Returned on every outcome, including a refusal. The caller is told that the attempt was recorded, because an audit trail a consumer does not know exists is one it cannot reason about.",
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "recorded_at": {
          "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/recorded_at"
        }
      },
      "required": [
        "event_id",
        "recorded_at"
      ]
    },
    "error": {
      "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.error:v1"
    },
    "horizon": {
      "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.horizon:v1"
    }
  },
  "required": [
    "outcome",
    "audit",
    "horizon"
  ]
}
