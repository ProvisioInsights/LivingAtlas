{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:living-atlas:contract:2026.08.3:tool:atlas.assertion.query.v1:output",
  "title": "atlas.assertion.query.v1 — result",
  "description": "The bitemporal read. as_of_recorded selects what Atlas believed at an instant; as_of_valid selects what was true over a span of world time; the axes are independent. Set full_scan to bootstrap a mirror — the last page hands off to the change feed at an exact seq with no gap.",
  "type": "object",
  "properties": {
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "record_schema"
        ],
        "properties": {
          "record_schema": {
            "type": "string",
            "minLength": 1,
            "x-atlas-known-values": [
              "atlas.assertion:v1",
              "atlas.redaction:v1"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "record_schema"
              ],
              "properties": {
                "record_schema": {
                  "const": "atlas.assertion:v1"
                }
              }
            },
            "then": {
              "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.assertion:v1"
            }
          },
          {
            "if": {
              "required": [
                "record_schema"
              ],
              "properties": {
                "record_schema": {
                  "const": "atlas.redaction:v1"
                }
              }
            },
            "then": {
              "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.redaction:v1"
            }
          }
        ]
      }
    },
    "contested": {
      "type": "array",
      "description": "Empty is a real answer. A non-empty group means Atlas holds two live, mutually exclusive beliefs and is reporting both rather than picking one.",
      "items": {
        "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/contested_group"
      }
    },
    "page": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/page"
    },
    "coverage": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/coverage"
    },
    "horizon": {
      "$ref": "urn:living-atlas:contract:2026.08.3:record:atlas.horizon:v1"
    },
    "cache": {
      "$ref": "urn:living-atlas:contract:2026.08.3:common:output#/$defs/cache"
    }
  },
  "required": [
    "results",
    "contested",
    "page",
    "coverage",
    "horizon",
    "cache"
  ]
}
